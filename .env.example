# Viettel AI TTS token for the demo voice-over script (docs/demo/lib/voiceover.py).
# Server-side only: no VITE_ prefix, never shipped to the browser. Get one at
# https://viettelai.vn/dashboard/token
VIETTEL_TTS_TOKEN=

# Demo recording scripts (docs/demo): passwords of the local test-lab accounts
# (TST-* users, SA-001) and of the accounts the scripts create. Never committed.
DEMO_TEST_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_NEW_USER_PASSWORD=
